# Copy to .agent/local.env (setup does it) and fill in. Never commit .agent/local.env:
# it is git-ignored, and the hooks refuse to let agents read it.
# How to create each token: docs/02-setup.md in the kit.

# ---- Jira / Confluence ----
# Cloud: your Atlassian e-mail + an API token (id.atlassian.com > Security > API tokens).
# Data Center: leave JIRA_USER empty and use a personal access token.
JIRA_USER=you@yourcompany.com
JIRA_TOKEN=
# Confluence Cloud reuses the Jira token. Data Center: its own personal access token.
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
# Only for scoped Cloud tokens, which must go through the API gateway:
# JIRA_BASE_URL=https://api.atlassian.com/ex/jira/<cloudId>
# CONFLUENCE_BASE_URL=https://api.atlassian.com/ex/confluence/<cloudId>/wiki

# ---- Jenkins (read failed builds of your PRs) ----
# Jenkins > your name (top right) > Security (or Configure) > API Token > Add new Token
JENKINS_USER=your-jenkins-username
JENKINS_TOKEN=

# ---- SonarQube (read the PR quality gate and new issues) ----
# SonarQube > My Account > Security > Generate Tokens (type: User token)
SONAR_TOKEN=

# ---- Network (only if your company needs a proxy) ----
# HTTPS_PROXY=http://proxy.yourcompany.com:8080
