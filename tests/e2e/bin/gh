#!/usr/bin/env python3
"""Fake gh for the end-to-end test: pr create/view/checks and auth status, backed by the mock server."""
import json
import os
import subprocess
import sys
import urllib.request

PORT = os.environ.get("MOCK_PORT", "18080")
BASE = "http://127.0.0.1:%s" % PORT


def call(method, path, data=None):
    req = urllib.request.Request(BASE + path, method=method, data=json.dumps(data).encode() if data is not None else None, headers={"Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(req).read() or b"{}")


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()


args = sys.argv[1:]
branch = git("rev-parse", "--abbrev-ref", "HEAD")
if args[:2] == ["auth", "status"]:
    print("github.test: logged in as dev")
    sys.exit(0)
if args[:2] == ["pr", "create"]:
    title = args[args.index("--title") + 1] if "--title" in args else "PR"
    pr = call("POST", "/__gh/pr", {"branch": branch, "title": title, "head": git("rev-parse", "HEAD")})
    print(pr["url"])
    sys.exit(0)
if args[:2] == ["pr", "view"]:
    pr = call("GET", "/__gh/pr?branch=" + branch)
    if not pr:
        print("no pull requests found for branch \"%s\"" % branch, file=sys.stderr)
        sys.exit(1)
    pr["headRefOid"] = git("rev-parse", "HEAD")  # the remote has what we pushed
    print(json.dumps(pr))
    sys.exit(0)
if args[:2] == ["pr", "checks"]:
    cs = call("GET", "/__gh/checks?head=" + git("rev-parse", "HEAD"))
    if not cs:
        print("no checks reported on the 'x' branch", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(cs))
    sys.exit(0)
print("fake gh: unsupported " + " ".join(args), file=sys.stderr)
sys.exit(1)
