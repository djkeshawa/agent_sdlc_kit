#!/usr/bin/env python3
"""Fake gh for the end-to-end test: pr create/view/checks and auth status, backed by the mock server."""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

PORT = os.environ.get("MOCK_PORT", "18080")
BASE = "http://127.0.0.1:%s" % PORT


def call(method, path, data=None):
    req = urllib.request.Request(BASE + path, method=method, data=json.dumps(data).encode() if data is not None else None, headers={"Content-Type": "application/json"})
    return json.loads(urllib.request.urlopen(req).read() or b"{}")


def git(*a):
    return subprocess.run(["git", *a], capture_output=True, text=True).stdout.strip()


args = sys.argv[1:]
branch = git("rev-parse", "--abbrev-ref", "HEAD")
if args[:2] == ["auth", "status"]:
    print("github.test: logged in as dev")
    sys.exit(0)
if args[:2] == ["pr", "create"]:
    title = args[args.index("--title") + 1] if "--title" in args else "PR"
    pr = call("POST", "/__gh/pr", {"branch": branch, "title": title, "head": git("rev-parse", "HEAD")})
    print(pr["url"])
    sys.exit(0)
if args[:2] == ["pr", "view"]:
    pr = call("GET", "/__gh/pr?branch=" + branch)
    if not pr:
        print("no pull requests found for branch \"%s\"" % branch, file=sys.stderr)
        sys.exit(1)
    pr["headRefOid"] = git("rev-parse", "HEAD")  # the remote has what we pushed
    print(json.dumps(pr))
    sys.exit(0)
if args[:2] == ["pr", "checks"]:
    cs = call("GET", "/__gh/checks?head=" + git("rev-parse", "HEAD"))
    if not cs:
        print("no checks reported on the 'x' branch", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(cs))
    sys.exit(0)
if args[:1] == ["api"]:
    if "search/commits" in args:
        q = next(a[2:] for a in args if a.startswith("q="))
        print(json.dumps(call("GET", "/__gh/commits?q=" + urllib.parse.quote(q))))
        sys.exit(0)
    listing = next((a for a in args[1:] if a.startswith("repos/") and ("/branches" in a or "/commits" in a)), None)
    if listing:
        repo = "/".join(listing[len("repos/"):].split("/")[:2])
        kind = "branches" if "/branches" in listing else "commits"
        page = urllib.parse.parse_qs(urllib.parse.urlparse(listing).query).get("page", ["1"])[0]
        print(json.dumps(call("GET", "/__gh/repo?repo=%s&kind=%s&page=%s" % (urllib.parse.quote(repo), kind, page))))
        sys.exit(0)
    target = next((a for a in args[1:] if a.startswith("repos/") and "/contents/" in a), None)
    if target:
        repo, path = target[len("repos/"):].split("/contents/", 1)
        try:
            print(urllib.request.urlopen(BASE + "/__gh/file?ref=" + urllib.parse.quote(repo + ":" + path)).read().decode(), end="")
            sys.exit(0)
        except urllib.error.HTTPError:
            print("gh: Not Found (HTTP 404)", file=sys.stderr)
            sys.exit(1)
print("fake gh: unsupported " + " ".join(args), file=sys.stderr)
sys.exit(1)
